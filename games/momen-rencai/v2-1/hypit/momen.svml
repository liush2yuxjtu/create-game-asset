    <overlay:Cue id="o-comment" kind="badge" text="👇 评论区报出你的层数" at="28.95s" for="2.05s" y="0.625" color="linear-gradient(90deg,#FF2D55,#FF7A00)"/>
  </overlay:Scene>

  <film:Film id="main" canvas={vertical} timeline={program.timeline} appearance={look.film.main}>
    <film:Track source={footage.visual}/>
    <film:Track source={overlay.track}/>
    <film:Track source={voice.audio}/>
    <film:Track source={music.audio}/>
    <film:Track source={sfx.audio}/>
  </film:Film>
  <render:Video id="final" composition={main.composition} timeline={program.timeline}/>
</svml>
