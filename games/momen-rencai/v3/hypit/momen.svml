<?svml using="@hypit/markup@1"?>
<svml>
  <!-- 由 tools/gen_svml.py 从 screens.json 生成，勿手改。 -->
  <import as="asset" from="@hypit/media@1"/>
  <import as="pipeline" from="@hypit/media-pipeline@1"/>
  <import as="program" from="@hypit/program-space@1"/>
  <import as="time" from="@hypit/timeline-author@1"/>
  <import as="space" from="@hypit/spatial@1"/>
  <import as="mt" from="@hypit/media-track@1"/>
  <import as="audio" from="@hypit/audio-track@1"/>
  <import as="typo" from="@hypit/typography-track@1"/>
  <import as="film" from="@hypit/film@1"/>
  <import as="render" from="@hypit/render-hyperframes@1"/>
  <import as="look" source="./momen.svs"/>

  <asset:Video id="gameplay-file" src="./assets/footage/gameplay_clean.mp4"/>
  <asset:Font id="pixel" src="./assets/fonts/pixel-v3-subset.ttf" weight="400" style="normal"/>
  <asset:Audio id="bgm-file" src="./assets/audio/bgm_loop.wav"/>
  <asset:Audio id="whoosh-file" src="./assets/audio/sfx_whoosh.wav"/>
  <asset:Audio id="reveal-file" src="./assets/audio/sfx_reveal.wav"/>
  <asset:Audio id="slam-file" src="./assets/audio/impactWood_light_002.ogg"/>
  <asset:Audio id="vo-s01-0-file" src="./assets/vo/s01-0.wav"/>
  <asset:Audio id="vo-s02-0-file" src="./assets/vo/s02-0.wav"/>
  <asset:Audio id="vo-s02-1-file" src="./assets/vo/s02-1.wav"/>
  <asset:Audio id="vo-s03-0-file" src="./assets/vo/s03-0.wav"/>
  <asset:Audio id="vo-s04-0-file" src="./assets/vo/s04-0.wav"/>
  <asset:Audio id="vo-s05-0-file" src="./assets/vo/s05-0.wav"/>
  <asset:Audio id="vo-s06-0-file" src="./assets/vo/s06-0.wav"/>
  <asset:Audio id="vo-s07-0-file" src="./assets/vo/s07-0.wav"/>
  <asset:Audio id="vo-s08-0-file" src="./assets/vo/s08-0.wav"/>
  <asset:Audio id="vo-s09-0-file" src="./assets/vo/s09-0.wav"/>

  <program:Clock id="clock" frame-rate="30"/>
  <pipeline:Normalize id="gameplay" source={gameplay-file} clock={clock} video="primary-moving" audio="none" span-authority="video"/>
  <pipeline:Normalize id="bgm" source={bgm-file} clock={clock} video="none" audio="default" span-authority="audio"/>
  <pipeline:Normalize id="whoosh" source={whoosh-file} clock={clock} video="none" audio="default" span-authority="audio"/>
  <pipeline:Normalize id="reveal" source={reveal-file} clock={clock} video="none" audio="default" span-authority="audio"/>
  <pipeline:Normalize id="slam" source={slam-file} clock={clock} video="none" audio="default" span-authority="audio"/>
  <pipeline:Normalize id="vo-s01-0" source={vo-s01-0-file} clock={clock} video="none" audio="default" span-authority="audio"/>
  <pipeline:Normalize id="vo-s02-0" source={vo-s02-0-file} clock={clock} video="none" audio="default" span-authority="audio"/>
  <pipeline:Normalize id="vo-s02-1" source={vo-s02-1-file} clock={clock} video="none" audio="default" span-authority="audio"/>
  <pipeline:Normalize id="vo-s03-0" source={vo-s03-0-file} clock={clock} video="none" audio="default" span-authority="audio"/>
  <pipeline:Normalize id="vo-s04-0" source={vo-s04-0-file} clock={clock} video="none" audio="default" span-authority="audio"/>
  <pipeline:Normalize id="vo-s05-0" source={vo-s05-0-file} clock={clock} video="none" audio="default" span-authority="audio"/>
  <pipeline:Normalize id="vo-s06-0" source={vo-s06-0-file} clock={clock} video="none" audio="default" span-authority="audio"/>
  <pipeline:Normalize id="vo-s07-0" source={vo-s07-0-file} clock={clock} video="none" audio="default" span-authority="audio"/>
  <pipeline:Normalize id="vo-s08-0" source={vo-s08-0-file} clock={clock} video="none" audio="default" span-authority="audio"/>
  <pipeline:Normalize id="vo-s09-0" source={vo-s09-0-file} clock={clock} video="none" audio="default" span-authority="audio"/>

  <time:Timeline id="program" clock={clock} end="727f"/>
  <space:Canvas id="canvas" width="1080" height="1920"/>
  <space:Frame id="title-band" within={canvas} left="40px" top="24px" right="1040px" bottom="96px"/>
  <space:Frame id="cap-band" within={canvas} left="40px" top="104px" right="1040px" bottom="282px"/>
  <space:Frame id="phone" within={canvas} left="90px" top="290px" right="990px" bottom="1890px"/>

  <mt:Track id="game" timeline={program.timeline} canvas={canvas}>
    <mt:Item id="s01" media={gameplay.media} frame={phone} appearance={look.media.s01} at="0f" for="61f">
      <mt:Sampling at="start" zoom="1" easing="ease-in-out"/>
      <mt:Sampling at="end" zoom="1.12" x="54" y="96"/>
    </mt:Item>
    <mt:Item id="s02" media={gameplay.media} frame={phone} appearance={look.media.s02} at="61f" for="120f">
      <mt:Sampling at="start" zoom="1" easing="ease-in-out"/>
      <mt:Sampling at="end" zoom="1.12" x="54" y="96"/>
    </mt:Item>
    <mt:Item id="s03" media={gameplay.media} frame={phone} appearance={look.media.s03} at="181f" for="42f">
      <mt:Sampling at="start" zoom="1" easing="ease-in-out"/>
      <mt:Sampling at="end" zoom="1.12" x="54" y="96"/>
    </mt:Item>
    <mt:Item id="s04" media={gameplay.media} frame={phone} appearance={look.media.s04} at="223f" for="54f">
      <mt:Sampling at="start" zoom="1" easing="ease-in-out"/>
      <mt:Sampling at="end" zoom="1.12" x="54" y="96"/>
    </mt:Item>
    <mt:Item id="s05" media={gameplay.media} frame={phone} appearance={look.media.s05} at="277f" for="114f">
      <mt:Sampling at="start" zoom="1" easing="ease-in-out"/>
      <mt:Sampling at="end" zoom="1.12" x="54" y="96"/>
    </mt:Item>
    <mt:Item id="s06" media={gameplay.media} frame={phone} appearance={look.media.s06} at="391f" for="102f">
      <mt:Sampling at="start" zoom="1" easing="ease-in-out"/>
      <mt:Sampling at="end" zoom="1.12" x="54" y="96"/>
    </mt:Item>
    <mt:Item id="s07" media={gameplay.media} frame={phone} appearance={look.media.s07} at="493f" for="60f">
      <mt:Sampling at="start" zoom="1" easing="ease-in-out"/>
      <mt:Sampling at="end" zoom="1.12" x="54" y="96"/>
    </mt:Item>
    <mt:Item id="s08" media={gameplay.media} frame={phone} appearance={look.media.s08} at="553f" for="48f">
      <mt:Sampling at="start" zoom="1" easing="ease-in-out"/>
      <mt:Sampling at="end" zoom="1.12" x="54" y="96"/>
    </mt:Item>
    <mt:Item id="s09" media={gameplay.media} frame={phone} appearance={look.media.s09} at="601f" for="126f">
      <mt:Sampling at="start" zoom="1" easing="ease-in-out"/>
      <mt:Sampling at="end" zoom="1.12" x="54" y="96"/>
    </mt:Item>
  </mt:Track>

  <typo:Style id="title-style" recipe={look.text.title} font={pixel}>
    <typo:Stroke color="#120D1A" width="6" placement="outside"/>
    <typo:Fill color="#F2C14E"/>
  </typo:Style>
  <typo:Style id="cap-style" recipe={look.text.cap} font={pixel}>
    <typo:Stroke color="#120D1A" width="8" placement="outside"/>
    <typo:Fill color="#FFFFFF"/>
  </typo:Style>
  <typo:Style id="cta-style" recipe={look.text.cta} font={pixel}>
    <typo:Glow color="#4FB8A6" blur="20"/>
    <typo:Stroke color="#120D1A" width="8" placement="outside"/>
    <typo:Fill color="#4FB8A6"/>
  </typo:Style>
  <typo:Motion id="pop">
    <typo:ItemKeyframe at="0" scale="1.12" opacity="0" easing="ease-out"/>
    <typo:ItemKeyframe at="4" scale="1" opacity="1"/>
  </typo:Motion>

  <typo:Track id="captions" timeline={program.timeline}>
    <typo:Area id="title" placement={title-band} style={title-style} during="program">每次死前，我能记住一件事</typo:Area>
    <typo:Area id="cap-s01" placement={cap-band} style={cap-style} motion={pop} at="0f" for="61f"><typo:P>就是这一件<typo:Break/>救了我的命</typo:P></typo:Area>
    <typo:Area id="cap-s02" placement={cap-band} style={cap-style} motion={pop} at="139f" for="42f"><typo:P>只能带一段</typo:P></typo:Area>
    <typo:Area id="cap-s03" placement={cap-band} style={cap-style} motion={pop} at="181f" for="42f"><typo:P>你会选<typo:Break/>哪一段？</typo:P></typo:Area>
    <typo:Area id="cap-s04" placement={cap-band} style={cap-style} motion={pop} at="223f" for="54f"><typo:P>重来一次<typo:Break/>只多知道一件事</typo:P></typo:Area>
    <typo:Area id="cap-s05" placement={cap-band} style={cap-style} motion={pop} at="277f" for="114f"><typo:P>记忆该什么时候用？</typo:P></typo:Area>
    <typo:Area id="cap-s06" placement={cap-band} style={cap-style} motion={pop} at="391f" for="102f"><typo:P>一件小事<typo:Break/>能改多少？</typo:P></typo:Area>
    <typo:Area id="cap-s07" placement={cap-band} style={cap-style} motion={pop} at="517f" for="36f"><typo:P>选对了<typo:Break/>就能活</typo:P></typo:Area>
    <typo:Area id="cap-s08" placement={cap-band} style={cap-style} motion={pop} at="553f" for="48f"><typo:P>下一世<typo:Break/>你带什么？</typo:P></typo:Area>
    <typo:Area id="cap-s09" placement={cap-band} style={cta-style} motion={pop} at="601f" for="126f"><typo:P>你会带哪段记忆<typo:Break/>进下一世？</typo:P></typo:Area>
  </typo:Track>

  <audio:Track id="sound" timeline={program.timeline}>
    <audio:Item id="music" source={bgm.media} during="program" playback="loop" gain="0.18" fade-out="30f"/>
    <audio:Item id="sfx-s01" source={whoosh.media} at="0f" for="24f" playback="once" gain="0.25"/>
    <audio:Item id="sfx-s02" source={whoosh.media} at="135f" for="24f" playback="once" gain="0.25"/>
    <audio:Item id="sfx-s03" source={reveal.media} at="177f" for="24f" playback="once" gain="0.35"/>
    <audio:Item id="sfx-s04" source={whoosh.media} at="219f" for="24f" playback="once" gain="0.25"/>
    <audio:Item id="sfx-s05" source={whoosh.media} at="273f" for="24f" playback="once" gain="0.25"/>
    <audio:Item id="sfx-s06" source={reveal.media} at="387f" for="24f" playback="once" gain="0.35"/>
    <audio:Item id="sfx-s07" source={whoosh.media} at="513f" for="24f" playback="once" gain="0.25"/>
    <audio:Item id="sfx-s08" source={whoosh.media} at="549f" for="24f" playback="once" gain="0.25"/>
    <audio:Item id="sfx-s09" source={slam.media} at="597f" for="24f" playback="once" gain="0.7"/>
    <audio:Item id="vo-s01-0-line" source={vo-s01-0.media} at="0f" for="58f" playback="once" gain="1"/>
    <audio:Item id="vo-s02-0-line" source={vo-s02-0.media} at="65f" for="69f" playback="once" gain="1"/>
    <audio:Item id="vo-s02-1-line" source={vo-s02-1.media} at="139f" for="34f" playback="once" gain="1"/>
    <audio:Item id="vo-s03-0-line" source={vo-s03-0.media} at="181f" for="36f" playback="once" gain="1"/>
    <audio:Item id="vo-s04-0-line" source={vo-s04-0.media} at="223f" for="54f" playback="once" gain="1"/>
    <audio:Item id="vo-s05-0-line" source={vo-s05-0.media} at="277f" for="109f" playback="once" gain="1"/>
    <audio:Item id="vo-s06-0-line" source={vo-s06-0.media} at="391f" for="101f" playback="once" gain="1"/>
    <audio:Item id="vo-s07-0-line" source={vo-s07-0.media} at="517f" for="34f" playback="once" gain="1"/>
    <audio:Item id="vo-s08-0-line" source={vo-s08-0.media} at="553f" for="47f" playback="once" gain="1"/>
    <audio:Item id="vo-s09-0-line" source={vo-s09-0.media} at="601f" for="117f" playback="once" gain="1"/>
  </audio:Track>

  <film:Film id="main" canvas={canvas} timeline={program.timeline} appearance={look.film.main}>
    <film:Track source={game.visual}/>
    <film:Track source={captions.track}/>
    <film:Track source={sound.audio}/>
  </film:Film>
  <render:Video id="final" composition={main.composition} timeline={program.timeline}/>
</svml>
