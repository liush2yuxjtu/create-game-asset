<?svml using="@hypit/markup@1"?>
<svml>
  <import as="asset" from="@hypit/media@1"/>
  <import as="pipeline" from="@hypit/media-pipeline@1"/>
  <import as="program" from="@hypit/program-space@1"/>
  <import as="time" from="@hypit/timeline-author@1"/>
  <import as="space" from="@hypit/spatial@1"/>
  <import as="mt" from="@hypit/media-track@1"/>
  <import as="audio" from="@hypit/audio-track@1"/>
  <import as="typo" from="@hypit/typography-track@1"/>
  <import as="film" from="@hypit/film@1"/>
  <import as="render" from="@hypit/render-hyperframes@1"/>
  <import as="look" source="./momen.svs"/>

  <!-- v3 · 故事工作台选定组合：只能带一件事 · 冷开场钩子 · 我 · 33s · 首尾循环 · 匀 · 问观众 · 手机框 · 轻推 · 字幕居中 · 音效开 -->
  <asset:Video id="gameplay-file" src="./assets/footage/gameplay_clean.mp4"/>
  <asset:Font id="pixel" src="./assets/fonts/pixel-v3-subset.ttf" weight="400" style="normal"/>
  <asset:Audio id="bgm-file" src="./assets/audio/bgm_loop.wav"/>
  <asset:Audio id="whoosh-file" src="./assets/audio/sfx_whoosh.wav"/>
  <asset:Audio id="reveal-file" src="./assets/audio/sfx_reveal.wav"/>
  <asset:Audio id="slam-file" src="./assets/audio/impactWood_light_002.ogg"/>

  <program:Clock id="clock" frame-rate="30"/>
  <pipeline:Normalize id="gameplay" source={gameplay-file} clock={clock} video="primary-moving" audio="none" span-authority="video"/>
  <pipeline:Normalize id="bgm" source={bgm-file} clock={clock} video="none" audio="default" span-authority="audio"/>
  <pipeline:Normalize id="whoosh" source={whoosh-file} clock={clock} video="none" audio="default" span-authority="audio"/>
  <pipeline:Normalize id="reveal" source={reveal-file} clock={clock} video="none" audio="default" span-authority="audio"/>
  <pipeline:Normalize id="slam" source={slam-file} clock={clock} video="none" audio="default" span-authority="audio"/>

  <time:Timeline id="program" clock={clock} end="33s"/>
  <space:Canvas id="canvas" width="1080" height="1920"/>
  <space:Frame id="phone" within={canvas} left="90px" top="290px" right="990px" bottom="1890px"/>
  <space:Frame id="title-band" within={canvas} left="40px" top="40px" right="1040px" bottom="150px"/>
  <space:Frame id="sub-band" within={canvas} left="40px" top="150px" right="1040px" bottom="250px"/>
  <space:Frame id="cap-mid" within={canvas} left="130px" top="840px" right="950px" bottom="1160px"/>

  <mt:Track id="game" timeline={program.timeline} canvas={canvas}>
    <mt:Item id="s01" media={gameplay.media} frame={phone} appearance={look.media.s01} at="0f" for="93f">
      <mt:Sampling at="start" zoom="1" easing="ease-in-out"/>
      <mt:Sampling at="end" zoom="1.12" x="54" y="96"/>
    </mt:Item>
    <mt:Item id="s02" media={gameplay.media} frame={phone} appearance={look.media.s02} at="93f" for="90f">
      <mt:Sampling at="start" zoom="1" easing="ease-in-out"/>
      <mt:Sampling at="end" zoom="1.12" x="54" y="96"/>
    </mt:Item>
    <mt:Item id="s03" media={gameplay.media} frame={phone} appearance={look.media.s03} at="183f" for="138f">
      <mt:Sampling at="start" zoom="1" easing="ease-in-out"/>
      <mt:Sampling at="end" zoom="1.12" x="54" y="96"/>
    </mt:Item>
    <mt:Item id="s04" media={gameplay.media} frame={phone} appearance={look.media.s04} at="321f" for="138f">
      <mt:Sampling at="start" zoom="1" easing="ease-in-out"/>
      <mt:Sampling at="end" zoom="1.12" x="54" y="96"/>
    </mt:Item>
    <mt:Item id="s05" media={gameplay.media} frame={phone} appearance={look.media.s05} at="459f" for="138f">
      <mt:Sampling at="start" zoom="1" easing="ease-in-out"/>
      <mt:Sampling at="end" zoom="1.12" x="54" y="96"/>
    </mt:Item>
    <mt:Item id="s06" media={gameplay.media} frame={phone} appearance={look.media.s06} at="597f" for="90f">
      <mt:Sampling at="start" zoom="1" easing="ease-in-out"/>
      <mt:Sampling at="end" zoom="1.12" x="54" y="96"/>
    </mt:Item>
    <mt:Item id="s07" media={gameplay.media} frame={phone} appearance={look.media.s07} at="687f" for="93f">
      <mt:Sampling at="start" zoom="1" easing="ease-in-out"/>
      <mt:Sampling at="end" zoom="1.12" x="54" y="96"/>
    </mt:Item>
    <mt:Item id="s08" media={gameplay.media} frame={phone} appearance={look.media.s08} at="780f" for="90f">
      <mt:Sampling at="start" zoom="1" easing="ease-in-out"/>
      <mt:Sampling at="end" zoom="1.12" x="54" y="96"/>
    </mt:Item>
    <mt:Item id="s09" media={gameplay.media} frame={phone} appearance={look.media.s09} at="870f" for="120f">
      <mt:Sampling at="start" zoom="1" easing="ease-in-out"/>
      <mt:Sampling at="end" zoom="1.12" x="54" y="96"/>
    </mt:Item>
  </mt:Track>

  <typo:Style id="title-style" recipe={look.text.title} font={pixel}>
    <typo:Stroke color="#120D1A" width="8" placement="outside"/>
    <typo:Fill color="#F2C14E"/>
  </typo:Style>
  <typo:Style id="sub-style" recipe={look.text.sub} font={pixel}>
    <typo:Stroke color="#120D1A" width="6" placement="outside"/>
    <typo:Fill color="#FFFFFF"/>
  </typo:Style>
  <typo:Style id="cap-style" recipe={look.text.cap} font={pixel}>
    <typo:Box target="frame" color="#120D1AD9" radius="18"/>
    <typo:Stroke color="#120D1A" width="8" placement="outside"/>
    <typo:Fill color="#FFFFFF"/>
  </typo:Style>
  <typo:Style id="cta-style" recipe={look.text.cta} font={pixel}>
    <typo:Box target="frame" color="#120D1AE6" radius="18" border-color="#4FB8A6" border-width="4"/>
    <typo:Glow color="#4FB8A6" blur="24"/>
    <typo:Stroke color="#120D1A" width="8" placement="outside"/>
    <typo:Fill color="#4FB8A6"/>
  </typo:Style>
  <typo:Motion id="pop">
    <typo:ItemKeyframe at="0" scale="1.15" opacity="0" easing="ease-out"/>
    <typo:ItemKeyframe at="5" scale="1" opacity="1"/>
  </typo:Motion>

  <typo:Track id="captions" timeline={program.timeline}>
    <typo:Area id="title" placement={title-band} style={title-style} during="program">每次死前，我能记住一件事</typo:Area>
    <typo:Area id="subtitle" placement={sub-band} style={sub-style} during="program">第100世，我终于选对了那一件</typo:Area>
    <typo:Area id="cap-s01" placement={cap-mid} style={cap-style} motion={pop} at="0f" for="93f"><typo:P>就是这一件<typo:Break/>救了我的命</typo:P></typo:Area>
    <typo:Area id="cap-s02" placement={cap-mid} style={cap-style} motion={pop} at="93f" for="90f"><typo:P>三段记忆<typo:Break/>只能带一段</typo:P></typo:Area>
    <typo:Area id="cap-s03" placement={cap-mid} style={cap-style} motion={pop} at="183f" for="138f"><typo:P>你会选<typo:Break/>哪一段？</typo:P></typo:Area>
    <typo:Area id="cap-s04" placement={cap-mid} style={cap-style} motion={pop} at="321f" for="138f"><typo:P>重来一次<typo:Break/>只多知道一件事</typo:P></typo:Area>
    <typo:Area id="cap-s05" placement={cap-mid} style={cap-style} motion={pop} at="459f" for="138f"><typo:P>记忆该什么时候用？</typo:P></typo:Area>
    <typo:Area id="cap-s06" placement={cap-mid} style={cap-style} motion={pop} at="597f" for="90f"><typo:P>一件小事<typo:Break/>能改多少？</typo:P></typo:Area>
    <typo:Area id="cap-s07" placement={cap-mid} style={cap-style} motion={pop} at="687f" for="93f"><typo:P>选对了<typo:Break/>就能活</typo:P></typo:Area>
    <typo:Area id="cap-s08" placement={cap-mid} style={cap-style} motion={pop} at="780f" for="90f"><typo:P>下一世<typo:Break/>你带什么？</typo:P></typo:Area>
    <typo:Area id="cap-s09" placement={cap-mid} style={cta-style} motion={pop} at="870f" for="120f"><typo:P>你会带哪段记忆<typo:Break/>进下一世？</typo:P></typo:Area>
  </typo:Track>

  <audio:Track id="sound" timeline={program.timeline}>
    <audio:Item id="music" source={bgm.media} during="program" playback="loop" gain="0.55" fade-out="30f"/>
    <audio:Item id="sfx-s01" source={whoosh.media} at="0f" for="24f" playback="once" gain="0.4"/>
    <audio:Item id="sfx-s03" source={reveal.media} at="183f" for="24f" playback="once" gain="0.6"/>
    <audio:Item id="sfx-s06" source={whoosh.media} at="597f" for="24f" playback="once" gain="0.4"/>
    <audio:Item id="sfx-s08" source={whoosh.media} at="780f" for="24f" playback="once" gain="0.4"/>
    <audio:Item id="sfx-s09" source={slam.media} at="870f" for="24f" playback="once" gain="0.9"/>
  </audio:Track>

  <film:Film id="main" canvas={canvas} timeline={program.timeline} appearance={look.film.main}>
    <film:Track source={game.visual}/>
    <film:Track source={captions.track}/>
    <film:Track source={sound.audio}/>
  </film:Film>
  <render:Video id="final" composition={main.composition} timeline={program.timeline}/>
</svml>
